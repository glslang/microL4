# A short echo request padded to 60 bytes, as a NIC pads it: the padding
# is not data, so the reply carries two bytes and is padded itself.
config: 10.0.2.15/24 via 10.0.2.2, MAC 52:54:00:12:34:56
in: 525400123456 52550a000202 0806  # the gateway's ARP reply: the stack learns its MAC
    0001 0800 06 04 0002 52550a000202 0a000202 525400123456 0a00020f
event: net: gateway 10.0.2.2 is at 52:55:0a:00:02:02
in: 525400123456 52550a000202 0800  # 10.0.2.2 > 10.0.2.15, id 4660: ICMP echo request, id 0x1234 seq 1, 2 bytes; 60 bytes
    45 00 001e 1234 4000 40 01 109b 0a000202 0a00020f
    08 00 7d61 1234 0001
    6869
    00000000 00000000 00000000 00000000
out: 52550a000202 525400123456 0800  # 10.0.2.15 > 10.0.2.2, id 1: ICMP echo reply, id 0x1234 seq 1, 2 bytes; 60 bytes
     45 00 001e 0001 4000 40 01 22ce 0a00020f 0a000202
     00 00 8561 1234 0001
     6869
     00000000 00000000 00000000 00000000
stats: frames_in=2 frames_out=1 arp_learnt=1 icmp_answered=1
