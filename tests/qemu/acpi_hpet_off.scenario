# Without an HPET the ACPI summary says so and the rest is unchanged. From
# the timer onwards this machine has no timer reference and panics
# (no_timer_reference); until then it boots.
cmdline: test=hello
qemu_args: -machine hpet=off
exit: success
expect: acpi: MADT flags 0x1 PCAT_COMPAT
expect: acpi: COM1 is ISA IRQ 4 -> GSI 4, edge, active high
expect: acpi: no HPET
expect: acpi: ECAM segment 0, buses 0-255, at 0xe0000000
expect: TEST PASS
