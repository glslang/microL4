# A ring-0 interrupt is taken only in the idle loop; `int 0x30` anywhere
# else panics.
cmdline: test=trap_irq_outside_idle
exit: failure
expect: microL4 kernel
expect: fatal trap: interrupt 0x30 (device IRQ 0) in ring 0, outside the idle loop: error 0x0, RIP
expect: CS 0x8, frame on the kernel stack
