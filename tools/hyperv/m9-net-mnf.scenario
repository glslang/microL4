# The M9 Hyper-V check's network run with netvsc.mnf=1
# (tools/hyperv/README.md, "At the M9 check"; docs/design.md, "The M9
# Hyper-V check"): m9-net.scenario's steps, but netvsc signals the host
# as FreeBSD's vmbus_chan_signal does: it sets its channel's bit in the
# event-flags page's guest-to-host half and, if the offer has HASMNF, its
# trigger's bit in monitor page 2, which root maps in netvsc's VSpace,
# and otherwise falls back to SignalEvent. Root's line says so. With
# m9-net, it shows which of the two ways the host takes. nic: is xtask's,
# so that udp_echo: parses here; the script ignores it.
cmdline: test=net net.ip=192.168.77.2/24 net.gw=192.168.77.1 netvsc.mnf=1
exit: success
nic: virtio-net
expect: cpu: hypervisor Hyper-V
expect: root: cmdline "test=net net.ip=192.168.77.2/24 net.gw=192.168.77.1 netvsc.mnf=1"
expect: servers: Hyper-V: SINT 2 is IRQ
expect: ; netvsc signals the host through monitor page 2 and the event flags (netvsc.mnf=1)
expect: servers: vmbus (priority 145, SINT 2 IRQ
expect: ), netvsc (priority 140), net (priority 130); root CNode
expect: vmbus: version
expect: vmbus: offer
expect: : netvsc, connection
expect: vmbus: netvsc channel
expect: open, connection
expect: netvsc: up: NVSP
expect: , MAC 00:15:5d:
expect: , link up,
expect: net: up: 192.168.77.2/24 via 192.168.77.1, MAC 00:15:5d:
expect: echo: listening on UDP port 7
udp_echo: 100
send: \r                           # root's line: report and end
expect: net: gateway 192.168.77.1 is at
expect: vmbus: stats: version
expect: , netvsc channel
expect: netvsc: stats: NVSP
expect: , 0 dropped for no buffer,
expect: , 0 broken packets,
expect: , 0 bad queue entries
expect: net: stats:
expect: , 4 ICMP echo requests answered,
expect: , 100 datagrams echoed,
expect: , 0 frames dropped, 0 bad entries,
expect: TEST PASS
forbid: TEST FAIL
forbid: KERNEL PANIC
forbid: USER PANIC
